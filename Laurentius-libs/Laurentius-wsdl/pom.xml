<?xml version="1.0"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>si.vsrs.cif.sed</groupId>
        <artifactId>Laurentius</artifactId>
        <version>2.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>Laurentius-wsdl</artifactId>

    <name>Laurentius-wsdl</name>
    <description>Laurentius-wsdl (interface)
        Modul generates java client and jax-ws interface objects from WSDL interface defined in resources/wsdl.
    </description>
    <licenses>
        <license>
            <name>European Union Public Licence (EUPL)</name>
            <url>https://joinup.ec.europa.eu/software/page/eupl</url>
            <distribution>repo</distribution>
            <comments>European Free/Open Source Software (F/OSS) licence</comments>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>jrc</id>
            <name>Jože Rihtaršič</name>
            <url>https://www.linkedin.com/in/jozerihtarsic/</url>

            <roles>
                <role>architect</role>
                <role>developer</role>
            </roles>
        </developer>
    </developers>

    <build>
        <plugins>
            <plugin>
                <groupId>com.sun.xml.ws</groupId>
                <artifactId>jaxws-maven-plugin</artifactId>
                <version>4.0.0</version>
                <dependencies>
                    <!-- put xjc-plugins on the jaxws-maven-plugin's classpath -->
                    <!-- TODO check if there are any alternatives to third party libraries -->
                    <dependency>
                        <groupId>codes.rafael.jaxb2_commons</groupId>
                        <artifactId>jaxb2-basics</artifactId>
                        <version>3.0.0</version>
                    </dependency>

                </dependencies>
                <configuration>
                    <xjcArgs>
                        <xjcArg>-Xequals</xjcArg>
                        <xjcArg>-XtoString</xjcArg>
                        <xjcArg>-XhashCode</xjcArg>
                    </xjcArgs>
                    <wsdlFiles>
                        <wsdlFile>mailbox.wsdl</wsdlFile>
                    </wsdlFiles>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- TODO check if there are any alternatives to third party libraries -->
        <dependency>
            <groupId>codes.rafael.jaxb2_commons</groupId>
            <artifactId>jaxb2-basics-runtime</artifactId>
            <version>3.0.0</version>
        </dependency>

    </dependencies>
</project>
