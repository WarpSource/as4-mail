                <MPC>http://docs.oasis-open.org/ebxml-msg/ebms/v3.0/ns/core/200704/defaultMPC</MPC>
                <Transport>
                    <ForeChannel action="DeliveryEC" securityIdRef="edeliveryAS4-2.0-EC">
