    <SecurityPolicies>
        <Security id="sign_sha256" WSSVersion="1.1">
            <X509>
                <Signature hashFunction="http://www.w3.org/2001/04/xmlenc#sha256"
                           algorithm="http://www.w3.org/2001/04/xmldsig-more#rsa-sha256"
                           keyIdentifierType="X509KeyIdentifier"
                >
                    <Reference allAttachments="true">
                        <Elements>
                            <XPath xpath="env:Header/eb3:Messaging">
                                <Namespace prefix="eb3" namespace="http://docs.oasis-open.org/ebxml-msg/ebms/v3.0/ns/core/200704/"/>
                                <Namespace prefix="env" namespace="http://www.w3.org/2003/05/soap-envelope"/>
                            </XPath>
                        </Elements>
                    </Reference>
                </Signature>
            </X509>
        </Security>


        <Security id="sign_ed25519" WSSVersion="1.1">
            <X509>
                <Signature hashFunction="http://www.w3.org/2001/04/xmlenc#sha256"
                           algorithm="http://www.w3.org/2021/04/xmldsig-more#eddsa-ed25519"
                           keyIdentifierType="X509KeyIdentifier">
                    <Reference allAttachments="true">
                        <Elements>
                            <XPath xpath="env:Header/eb3:Messaging">
                                <Namespace prefix="eb3"
                                           namespace="http://docs.oasis-open.org/ebxml-msg/ebms/v3.0/ns/core/200704/"/>
                                <Namespace prefix="env" namespace="http://www.w3.org/2003/05/soap-envelope"/>
                            </XPath>
                        </Elements>
                    </Reference>
                </Signature>
            </X509>
        </Security>



        <Security id="sign_ecdsa" WSSVersion="1.1">
            <X509>
                <Signature hashFunction="http://www.w3.org/2001/04/xmlenc#sha256"
                           algorithm="http://www.w3.org/2001/04/xmldsig-more#ecdsa-sha256"
                           keyIdentifierType="X509KeyIdentifier">
                    <Reference allAttachments="true">
                        <Elements>
                            <XPath xpath="env:Header/eb3:Messaging">
                                <Namespace prefix="eb3"
                                           namespace="http://docs.oasis-open.org/ebxml-msg/ebms/v3.0/ns/core/200704/"/>
                                <Namespace prefix="env" namespace="http://www.w3.org/2003/05/soap-envelope"/>
                            </XPath>
                        </Elements>
                    </Reference>
                </Signature>
            </X509>
        </Security>
        <Security id="edeliveryAS4_v1.5" WSSVersion="1.1">
            <X509>
                <Signature hashFunction="http://www.w3.org/2001/04/xmlenc#sha256"
                           algorithm="http://www.w3.org/2001/04/xmldsig-more#rsa-sha256"
                           keyIdentifierType="X509KeyIdentifier">
                    <Reference allAttachments="true">
                        <Elements>
                            <XPath xpath="env:Header/env:Body">
                                <Namespace prefix="env" namespace="http://www.w3.org/2003/05/soap-envelope"/>
                            </XPath>
                            <XPath xpath="env:Header/eb3:Messaging">
                                <Namespace prefix="env" namespace="http://www.w3.org/2003/05/soap-envelope"/>
                                <Namespace prefix="eb3"
                                           namespace="http://docs.oasis-open.org/ebxml-msg/ebms/v3.0/ns/core/200704/"/>
                            </XPath>
                        </Elements>
                    </Reference>
                </Signature>
                <Encryption algorithm="http://www.w3.org/2009/xmlenc11#aes128-gcm"
                            keyTransport="http://www.w3.org/2009/xmlenc11#rsa-oaep"
                            mgf1Algorithm="http://www.w3.org/2009/xmlenc11#mgf1sha256"
                            digest="http://www.w3.org/2001/04/xmlenc#sha256" minimumStrength="128"
                            keyIdentifierType="X509KeyIdentifier">
                    <Reference allAttachments="true"/>
                </Encryption>
            </X509>
        </Security>
        <Security id="edeliveryAS4-2.0-curve25519" WSSVersion="1.1">
            <X509>
                <Signature hashFunction="http://www.w3.org/2001/04/xmlenc#sha256"
                           algorithm="http://www.w3.org/2021/04/xmldsig-more#eddsa-ed25519"
                           keyIdentifierType="X509KeyIdentifier">
                    <Reference allAttachments="true">
                        <Elements>
                            <XPath xpath="env:Header/env:Body">
                                <Namespace prefix="env" namespace="http://www.w3.org/2003/05/soap-envelope"/>
                            </XPath>
                            <XPath xpath="env:Header/eb3:Messaging">
                                <Namespace prefix="env" namespace="http://www.w3.org/2003/05/soap-envelope"/>
                                <Namespace prefix="eb3"
                                           namespace="http://docs.oasis-open.org/ebxml-msg/ebms/v3.0/ns/core/200704/"/>
                            </XPath>
                        </Elements>
                    </Reference>
                </Signature>
                <Encryption algorithm="http://www.w3.org/2009/xmlenc11#aes128-gcm"
                            keyTransport="http://www.w3.org/2001/04/xmlenc#kw-aes128"
                            agreementMethod="http://www.w3.org/2021/04/xmldsig-more#x25519"
                            keyDerivationFunction="http://www.w3.org/2021/04/xmldsig-more#hkdf"
                            minimumStrength="128"
                            keyIdentifierType="X509KeyIdentifier">
                    <Reference allAttachments="true"/>
                </Encryption>
            </X509>
        </Security>
        <Security id="edeliveryAS4-2.0-EC" WSSVersion="1.1">
            <X509>
                <Signature hashFunction="http://www.w3.org/2001/04/xmlenc#sha256"
                           algorithm="http://www.w3.org/2001/04/xmldsig-more#ecdsa-sha256"
                           keyIdentifierType="X509KeyIdentifier">
                    <Reference allAttachments="true">
                        <Elements>
                            <XPath xpath="env:Header/env:Body">
                                <Namespace prefix="env" namespace="http://www.w3.org/2003/05/soap-envelope"/>
                            </XPath>
                            <XPath xpath="env:Header/eb3:Messaging">
                                <Namespace prefix="env" namespace="http://www.w3.org/2003/05/soap-envelope"/>
                                <Namespace prefix="eb3"
                                           namespace="http://docs.oasis-open.org/ebxml-msg/ebms/v3.0/ns/core/200704/"/>
                            </XPath>
                        </Elements>
                    </Reference>
                </Signature>
                <Encryption algorithm="http://www.w3.org/2009/xmlenc11#aes128-gcm"
                            keyTransport="http://www.w3.org/2001/04/xmlenc#kw-aes128"
                            agreementMethod="http://www.w3.org/2009/xmlenc11#ECDH-ES"
                            keyDerivationFunction="http://www.w3.org/2021/04/xmldsig-more#hkdf"
                            minimumStrength="128"
                            keyIdentifierType="X509KeyIdentifier">
                    <Reference allAttachments="true"/>
                </Encryption>
            </X509>
        </Security>

    </SecurityPolicies>
