<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="ebMS_LAU_PU" transaction-type="JTA">
        <provider>org.hibernate.ejb.HibernatePersistence</provider>
        <jta-data-source>java:/dsEBMS_SED</jta-data-source>
        <mapping-file>shared/hbm/msh-in-event.orm.xml</mapping-file>
        <mapping-file>shared/hbm/msh-in-mail.orm.xml</mapping-file>
        <mapping-file>shared/hbm/msh-in-payload.orm.xml</mapping-file>
        <mapping-file>shared/hbm/msh-out-event.orm.xml</mapping-file>
        <mapping-file>shared/hbm/msh-out-mail.orm.xml</mapping-file>
        <mapping-file>shared/hbm/msh-out-payload.orm.xml</mapping-file>
        <mapping-file>shared/hbm/msh-table-mail.hbm.xml</mapping-file>
        <mapping-file>shared/hbm/msh-type-decision-rule.orm.xml</mapping-file>
        <mapping-file>shared/hbm/msh-type-event.orm.xml</mapping-file>
        <mapping-file>shared/hbm/msh-type-mail.orm.xml</mapping-file>
        <mapping-file>shared/hbm/msh-type-part.orm.xml</mapping-file>
        <mapping-file>shared/hbm/msh-type-property.orm.xml</mapping-file>
        <mapping-file>shared/hbm/report-status.hbm.xml</mapping-file>
        <mapping-file>shared/hbm/sed-application.orm.xml</mapping-file>
        <mapping-file>shared/hbm/sed-box.orm.xml</mapping-file>
        <mapping-file>shared/hbm/sed-cert-store.orm.xml</mapping-file>
        <mapping-file>shared/hbm/sed-cron.orm.xml</mapping-file>
        <mapping-file>shared/hbm/sed-interceptor.orm.xml</mapping-file>
        <mapping-file>shared/hbm/sed-process.orm.xml</mapping-file>
        <mapping-file>shared/hbm/sed-property.orm.xml</mapping-file>
        <mapping-file>shared/hbm/sed-user.orm.xml</mapping-file>
        <shared-cache-mode>UNSPECIFIED</shared-cache-mode>
        <properties>
            <property name="jboss.entity.manager.jndi.name" value="java:/ebMS_MSH_PU"/>
            <!-- hibernate.jpa.compliance.global_id_generators needs to be set to false because different
            sequences are used on same superclass entity.-->
            <property name="hibernate.jpa.compliance.global_id_generators" value="false"/>
            <property name="hibernate.dialect" value="${laurentius.hibernate.dialect}"/>
            <property name="hibernate.hbm2ddl.auto" value="${laurentius.hibernate.hbm2ddl.auto}"/>
            <!-- This is due to remove the warning
            https://hibernate.atlassian.net/browse/HHH-15827
            At upgrade of hibernate-orm version check if this is still needed!
            hibernate-orm version 6.1.5.Final
            -->
            <property name="jakarta.persistence.sharedCache.mode" value="UNSPECIFIED"/>
        </properties>
    </persistence-unit>

</persistence>
