<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings
        xmlns="https://jakarta.ee/xml/ns/persistence/orm"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
        version="3.1">
    <named-query
            name="si.laurentius.msh.outbox.event.MSHOutEvent.getMailEventList">
        <query>
            <![CDATA[select p from MSHOutEvent p where p.mailId = :mailId order by p.id asc]]>
        </query>
    </named-query>
    <named-native-query
            name="si.laurentius.msh.outbox.event.MSHOutEvent.getList"
            result-class="si.laurentius.msh.outbox.event.MSHOutEvent">
        <query>
            <![CDATA[SELECT
                ev.id,
                ev.mail_id,
                ev.sender_msg_id,
                ev.status,
                ev.date,
                ev.description,
                ev.user_id,
                ev.application_id
              FROM
                public.lau_outbox_event ev,
                public.lau_outbox im
              WHERE
                ev.mail_id = im.id
                and im.sender_ebox = :senderEBox
                and (ev.mail_id = :mailId or :mailId is null)
                and (ev.sender_msg_id = :senderMessageId or :senderMessageId='')
                order by id desc]]>
        </query>
    </named-native-query>
    <entity class="si.laurentius.msh.outbox.event.MSHOutEvent" access="FIELD">
        <table name="LAU_OUTBOX_EVENT">
            <index column-list="MAIL_ID" name="idx_out_event_mail_id"/>
        </table>
        <sequence-generator name="SequenceMailEvent" sequence-name="SEQ_LAU_OUTBOX_EVENT" allocation-size="1"/>
    </entity>
</entity-mappings>


