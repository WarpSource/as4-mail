<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings
        xmlns="https://jakarta.ee/xml/ns/persistence/orm"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
        version="3.1">
    <named-query name="si.laurentius.msh.inbox.payload.MSHInPart.getMailPartList">
        <query>
            <![CDATA[select p from MSHInPart p where p.mailId = :mailId]]>
        </query>
    </named-query>
    <entity class="si.laurentius.msh.inbox.payload.MSHInPart" access="FIELD">
        <table name="LAU_INBOX_PAYLOAD">
            <index column-list="MAIL_ID" name="idx_inpart_mail_id"/>
            <index column-list="PART_EBMS_ID" name="idx_inpart_ebms_id"/>
        </table>
        <sequence-generator name="SequencePayload" sequence-name="SEQ_LAU_INBOX_PAYLOAD" allocation-size="1"/>
        <attributes>
            <one-to-many name="IMPartProperties"
                         fetch="EAGER"
                         orphan-removal="true"
                         access="FIELD">
                <!--order-by>ID ASC</order-by -->
                <join-column name="INPART_ID"/>
                <cascade>
                    <cascade-all/>
                </cascade>
            </one-to-many>
        </attributes>
    </entity>
    <entity class="si.laurentius.msh.inbox.payload.IMPartProperty" access="FIELD">
        <table name="LAU_INBOX_PAYLOAD_PROPERTY" />

        <sequence-generator name="SequenceProperty" sequence-name="SEQ_LAU_INBOX_PAYLOAD_PROP" allocation-size="1"/>

    </entity>
</entity-mappings>


