<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings
        xmlns="https://jakarta.ee/xml/ns/persistence/orm"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
        version="3.1">
    <named-query name="si.laurentius.cron.SEDTaskExecution.getAll">
        <query><![CDATA[SELECT p FROM SEDTaskExecution p]]></query>
    </named-query>
    <named-query name="si.laurentius.cron.SEDTaskExecution.getByStatusAndTypeAndCronJobId">
        <query><![CDATA[SELECT p FROM SEDTaskExecution p  where p.cronId=:cronId and p.status=:status and p.type=:type order by p.id desc]]></query>
    </named-query>
    <entity class="si.laurentius.cron.SEDTaskExecution" access="FIELD">
        <table name="LAU_TASK_EXECUTION">
        </table>
        <sequence-generator name="SequenceTaskExecution" sequence-name="SEQ_LAU_TASK_EXEC" allocation-size="1"/>
        <attributes>
            <id name="id">
                <column name="ID" scale="0"/>
                <generated-value strategy="SEQUENCE" generator="SequenceTaskExecution"/>
            </id>

            <basic name="cronId">
                <column name="CRON_ID" scale="0"/>
            </basic>
            <basic name="type">
                <column name="TASK_TYPE" length="64"/>
            </basic>
            <basic name="plugin">
                <column name="TASK_PLUGIN" length="64"/>
            </basic>
            <basic name="pluginVersion">
                <column name="TASK_PLUGIN_VERSION" length="32"/>
            </basic>
            <basic name="name">
                <column name="NAME" length="512"/>
            </basic>
            <basic name="status">
                <column name="STATUS" length="32"/>
            </basic>
            <basic name="result">
                <column name="RESULT" length="32"/>
            </basic>
            <basic name="status">
                <column name="STATUS" length="1024"/>
            </basic>
            <basic name="startTimestamp">
                <column name="START_DATE" nullable="false"/>
                <temporal>TIMESTAMP</temporal>
            </basic>
            <basic name="endTimestamp">
                <column name="END_DATE" nullable="true"/>
                <temporal>TIMESTAMP</temporal>
            </basic>
        </attributes>
    </entity>
</entity-mappings>
