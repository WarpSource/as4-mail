<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings
        xmlns="https://jakarta.ee/xml/ns/persistence/orm"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
        version="3.1">
    <named-query name="si.laurentius.property.SEDProperty.getAll">
        <query><![CDATA[SELECT p FROM SEDProperty p]]></query>
    </named-query>
    <named-query name="si.laurentius.property.SEDProperty.getByKey">
        <query><![CDATA[SELECT p FROM SEDProperty p where p.key=:key and p.group=:group]]></query>
    </named-query>
    <entity class="si.laurentius.property.SEDProperty" access="FIELD">
        <table name="LAU_SETTINGS">
        </table>
        <attributes>
            <id name="key">
                <column name="PROP_KEY" length="512"/>
            </id>
            <basic name="value">
                <column name="PROP_VALUE" length="1024"/>
            </basic>
            <basic name="group">
                <column name="LAU_GROUP" length="32"/>
            </basic>
        </attributes>
    </entity>
</entity-mappings>

