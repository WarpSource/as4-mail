<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings
        xmlns="https://jakarta.ee/xml/ns/persistence/orm"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
        version="3.1">
    <named-query name="si.laurentius.application.SEDApplication.getAll">
        <query><![CDATA[SELECT p FROM SEDApplication p order by p.applicationId asc]]></query>
    </named-query>
    <named-query name="si.laurentius.application.SEDApplication.getById">
        <query><![CDATA[SELECT p FROM SEDApplication p where p.applicationId=:id]]></query>
    </named-query>
    <entity class="si.laurentius.application.SEDApplication" access="FIELD">
        <table name="LAU_APPLICATION">
        </table>
        <attributes>
            <id name="applicationId">
                <column name="APPLICATION_ID" length="512"/>
            </id>
            <basic name="name">
                <column name="NAME" length="512"/>
            </basic>
            <basic name="desc">
                <column name="DESCRIPTION" length="1024"/>
            </basic>
            <basic name="email">
                <column name="EMAIL" length="512"/>
            </basic>
            <basic name="activeFromDate">
                <column name="ACTIVE_DATE_FROM" nullable="false"/>
                <temporal>TIMESTAMP</temporal>
            </basic>
            <basic name="activeFromDate">
                <column name="ACTIVE_DATE_TO" nullable="false"/>
                <temporal>TIMESTAMP</temporal>
            </basic>

            <many-to-many name="SEDBoxes"
                          fetch="EAGER"
                          access="FIELD">
                <map-key-class class="si.laurentius.ebox.SEDBox"/>
                <join-table name="LAU_APPLICATION_SEDBOX">
                    <join-column name="APPLICATION_ID"/>
                    <inverse-join-column name="LOCAL_BOX_NAME"/>
                </join-table>
                <cascade>
                    <cascade-all/>
                </cascade>
            </many-to-many>
        </attributes>
    </entity>
</entity-mappings>

