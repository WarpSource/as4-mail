<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings
        xmlns="https://jakarta.ee/xml/ns/persistence/orm"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
        version="3.1">
    <named-query name="si.laurentius.msh.inbox.mail.MSHInMail.getById">
        <query><![CDATA[SELECT p FROM MSHInMail p WHERE p.id = :id]]></query>
    </named-query>
    <named-query name="si.laurentius.msh.inbox.mail.MSHInMail.getByMessageId">
        <query><![CDATA[SELECT p FROM MSHInMail p WHERE p.messageId = :messageId]]></query>
    </named-query>
    <named-query name="si.laurentius.msh.inbox.mail.MSHInMail.getBySenderMessageId">
        <query><![CDATA[SELECT p FROM MSHInMail p WHERE p.senderMessageId = :senderMessageId]]></query>
    </named-query>
    <named-query name="si.laurentius.msh.inbox.mail.MSHInMail.getByConvIdAndAction">
        <query><![CDATA[SELECT p FROM MSHInMail p WHERE p.conversationId = :convId and p.action = :action]]></query>
    </named-query>
    <named-query name="si.laurentius.msh.inbox.mail.MSHInMail.getList">
        <query><![CDATA[SELECT p FROM MSHInMail p ]]></query>
    </named-query>
    <named-query name="si.laurentius.msh.inbox.mail.MSHInMail.getByIdAndReceiverBox">
        <query><![CDATA[SELECT p FROM MSHInMail p where p.id=:mailId and p.receiverEBox=:receiverEBox]]></query>
    </named-query>

    <named-query name="si.laurentius.msh.inbox.mail.MSHInMail.updateStatus">
        <query><![CDATA[UPDATE MSHInMail p set p.status = :status, p.statusDate=:statusDate where p.id = :id]]></query>
    </named-query>

    <entity class="si.laurentius.msh.inbox.mail.MSHInMail" access="FIELD">

        <table name="LAU_INBOX">
            <!-- identifier indexes -->
            <index column-list="MSG_ID" name="idx_in_ref_msg_id"/>
            <index column-list="REF_TO_MSG_ID" name="idx_in_ref_msg_id"/>
            <index column-list="SENDER_MSG_ID" name="idx_in_sender_msg_id"/>
            <index column-list="CONV_ID" name="idx_in_conv_id"/>
            <!-- event indexes -->
            <index column-list="STATUS" name="idx_in_status"/>
            <index column-list="DATE_STATUS" name="idx_in_date_status"/>
            <index column-list="DATE_SUBMITTED" name="idx_in_date_submit"/>
            <index column-list="DATE_SENT" name="idx_in_date_sent"/>
            <index column-list="DATE_RECEIVED" name="idx_in_date_received"/>
            <index column-list="DATE_DELIVERED" name="idx_in_date_delivered"/>
        </table>
        <sequence-generator name="SequenceMessage" sequence-name="SEQ_LAU_INBOX" allocation-size="1"/>
        <attributes>

            <embedded name="MSHInProperties" access="FIELD" >
                <association-override name="MSHInProperties.MSHInProperties">
                    <join-column name="MAIL_ID"/>
                </association-override>
            </embedded>
            <embedded name="MSHInPayload" access="FIELD">
                <association-override name="MSHInParts.MSHInParts">
                    <join-column name="MAIL_ID"/>
                </association-override>
            </embedded>
            <transient name="MSHInEvents" />
        </attributes>
    </entity>
    <entity class="si.laurentius.msh.inbox.property.MSHInProperty" access="FIELD">
        <table name="LAU_INBOX_PROPERTY"/>
        <sequence-generator name="SequenceProperty" sequence-name="SEQ_LAU_INBOX_PROP" allocation-size="1"/>
    </entity>
    <embeddable class="si.laurentius.msh.inbox.property.MSHInProperties" access="FIELD">
        <attributes>
            <one-to-many name="MSHInProperties"
                         fetch="EAGER"
                         orphan-removal="true"
                         access="FIELD">
                <!--order-by>ID ASC</order-by -->
                <join-column name="MAIL_ID"/>
                <cascade>
                    <cascade-all/>
                </cascade>
            </one-to-many>
        </attributes>
    </embeddable>
    <embeddable class="si.laurentius.msh.inbox.payload.MSHInPayload" access="FIELD">
        <attributes>
            <one-to-many name="MSHInParts"
                         fetch="EAGER"
                         orphan-removal="true"
                         access="FIELD">
                <!--order-by>ID ASC</order-by -->
                <join-column name="MAIL_ID"/>
                <cascade>
                    <cascade-all/>
                </cascade>
            </one-to-many>
        </attributes>
    </embeddable>
</entity-mappings>

