<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings
        xmlns="https://jakarta.ee/xml/ns/persistence/orm"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
        version="3.1">

    <named-query name="si.laurentius.msh.outbox.mail.MSHOutMail.getById">
        <query><![CDATA[SELECT p FROM MSHOutMail p WHERE p.id = :id]]></query>
    </named-query>
    <named-query name="si.laurentius.msh.outbox.mail.MSHOutMail.getByMessageId">
        <query><![CDATA[SELECT p FROM MSHOutMail p WHERE p.messageId = :messageId]]></query>
    </named-query>
    <named-query name="si.laurentius.msh.outbox.mail.MSHOutMail.getBySenderMessageId">
        <query><![CDATA[SELECT p FROM MSHOutMail p WHERE p.senderMessageId = :senderMessageId]]></query>
    </named-query>
    <named-query name="si.laurentius.msh.outbox.mail.MSHOutMail.getByMessageIdAndSenderBox">
        <query>
            <![CDATA[SELECT p FROM MSHOutMail p WHERE p.senderMessageId = :sndMsgId and senderEBox = :senderBox]]></query>
    </named-query>
    <named-query name="si.laurentius.msh.outbox.mail.MSHOutMail.getList">
        <query><![CDATA[SELECT p FROM MSHOutMail p ]]></query>
    </named-query>
    <named-query name="si.laurentius.msh.outbox.mail.MSHOutMail.updateStatus">
        <query><![CDATA[UPDATE MSHOutMail p set p.status = :status, p.statusDate=:statusDate where p.id = :id]]></query>
    </named-query>
    <named-query name="si.laurentius.msh.outbox.mail.MSHOutMail.updateSentDate">
        <query>
            <![CDATA[UPDATE MSHOutMail p set p.sentDate = :sentDate, p.receivedDate = :receivedDate  where p.id = :id]]></query>
    </named-query>
    <named-query name="si.laurentius.msh.outbox.mail.MSHOutMail.updateReceivedDate">
        <query><![CDATA[UPDATE MSHOutMail p set p.receivedDate = :receivedDate where p.id = :id]]></query>
    </named-query>
    <named-query name="si.laurentius.msh.outbox.mail.MSHOutMail.updateDeliveredDate">
        <query><![CDATA[UPDATE MSHOutMail p set p.deliveredDate = :deliveredDate where p.id = :id]]></query>
    </named-query>

    <entity class="si.laurentius.msh.outbox.mail.MSHOutMail" access="FIELD">
        <table name="LAU_OUTBOX">
            <!-- identifier indexes -->
            <index column-list="MSG_ID" name="idx_out_ref_msg_id"/>
            <index column-list="REF_TO_MSG_ID" name="idx_out_ref_msg_id"/>
            <index column-list="SENDER_MSG_ID" name="idx_out_sender_msg_id"/>
            <index column-list="CONV_ID" name="idx_out_conv_id"/>
            <!-- event indexes -->
            <index column-list="STATUS" name="idx_out_status"/>
            <index column-list="DATE_STATUS" name="idx_out_date_status"/>
            <index column-list="DATE_SUBMITTED" name="idx_out_date_submit"/>
            <index column-list="DATE_SENT" name="idx_out_date_sent"/>
            <index column-list="DATE_RECEIVED" name="idx_out_date_received"/>
            <index column-list="DATE_DELIVERED" name="idx_out_date_delivered"/>
        </table>
        <sequence-generator name="SequenceMessage" sequence-name="SEQ_LAU_OUTBOX" allocation-size="1"/>
        <attributes>
            <embedded name="MSHOutProperties" access="FIELD">
                <association-override name="MSHOutProperties.MSHOutProperties">
                    <join-column name="MAIL_ID"/>
                </association-override>
            </embedded>
            <embedded name="MSHOutPayload" access="FIELD">
                <association-override name="MSHOutParts.MSHOutParts">
                    <join-column name="MAIL_ID"/>
                </association-override>
            </embedded>
            <transient name="MSHOutEvents"/>
        </attributes>
    </entity>
    <entity class="si.laurentius.msh.outbox.property.MSHOutProperty" access="FIELD">
        <table name="LAU_OUTBOX_PROPERTY"/>
        <sequence-generator name="SequenceProperty" sequence-name="SEQ_LAU_OUTBOX_PROP" allocation-size="1"/>
    </entity>
    <embeddable class="si.laurentius.msh.outbox.property.MSHOutProperties" access="FIELD">
        <attributes>
            <one-to-many name="MSHOutProperties"
                         fetch="EAGER"
                         orphan-removal="true"
                         access="FIELD">
                <!--order-by>ID ASC</order-by -->
                <join-column name="MAIL_ID"/>
                <cascade>
                    <cascade-all/>
                </cascade>
            </one-to-many>
        </attributes>
    </embeddable>
    <embeddable class="si.laurentius.msh.outbox.payload.MSHOutPayload" access="FIELD">
        <attributes>
            <one-to-many name="MSHOutParts"
                         fetch="EAGER"
                         orphan-removal="true"
                         access="FIELD">
                <!--order-by>ID ASC</order-by -->
                <join-column name="MAIL_ID"/>
                <cascade>
                    <cascade-all/>
                </cascade>
            </one-to-many>
        </attributes>
    </embeddable>
</entity-mappings>

