<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings
        xmlns="https://jakarta.ee/xml/ns/persistence/orm"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
        version="3.1">
    <named-query name="si.laurentius.ebox.SEDBox.getAll">
        <query><![CDATA[SELECT p FROM SEDBox p order by p.localBoxName asc]]></query>
    </named-query>
    <named-query name="si.laurentius.ebox.SEDBox.getByName">
        <query><![CDATA[SELECT p FROM SEDBox p where p.localBoxName=:BoxName]]></query>
    </named-query>
    <entity class="si.laurentius.ebox.SEDBox" access="FIELD">
        <table name="LAU_BOX">
        </table>
        <attributes>
            <id name="localBoxName">
                <column name="LOCAL_BOX_NAME" length="512" />
            </id>

            <basic name="activeFromDate">
                <column name="ACTIVE_DATE_FROM" nullable="false"/>
                <temporal>TIMESTAMP</temporal>
            </basic>

            <basic name="activeFromDate">
                <column name="ACTIVE_DATE_TO" nullable="false"/>
                <temporal>TIMESTAMP</temporal>
            </basic>
        </attributes>
    </entity>
</entity-mappings>
