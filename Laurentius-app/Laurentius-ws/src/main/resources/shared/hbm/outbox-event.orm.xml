<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings
        xmlns="https://jakarta.ee/xml/ns/persistence/orm"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
        version="3.1">

    <named-native-query
            name="si.laurentius.outbox.event.OutEvent.getList"
            result-class="si.laurentius.outbox.event.OutEvent">
        <query>
            <![CDATA[SELECT
    ev.id,
    ev.mail_id,
    ev.status,
    ev.event_date,
    ev.description,
    ev.user_id,
    ev.application_id
  FROM
      lau_outbox_event ev
      JOIN
     lau_outbox im
        on ev.mail_id = im.id
  WHERE im.sender_ebox = :senderEBox
    and (ev.mail_id = :mailId or :mailId =-1)
    order by id asc]]>
        </query>
    </named-native-query>
    <named-native-query
            name="si.laurentius.outbox.event.OutEvent.getMailEventList"
            result-class="si.laurentius.outbox.event.OutEvent">
        <query>
            <![CDATA[[SELECT
  ev.*
FROM
  lau_outbox_event ev
WHERE ev.mail_id = :mailId
  order by id desc]]>
        </query>
    </named-native-query>

    <entity class="si.laurentius.outbox.event.OutEvent" access="FIELD">
        <table name="LAU_OUTBOX_EVENT">
            <index column-list="MAIL_ID" name="idx_out_event_mail_id"/>
            <!-- index column-list="SENDER_MSG_ID" name="idx_out_even_send_msg_id"/ -->
        </table>
        <sequence-generator name="SequenceOutboxEvent" sequence-name="SEQ_LAU_OUTBOX_EVENT" allocation-size="1"/>
        <attributes>
            <id name="id">
                <column name="ID" scale="0"/>
                <generated-value strategy="SEQUENCE" generator="SequenceOutboxEvent"/>
            </id>
            <basic name="mailId">
                <column name="MAIL_ID" nullable="false" scale="0"/>
            </basic>
            <basic name="description">
                <column name="DESCRIPTION" length="512"/>
            </basic>
            <basic name="userId">
                <column name="USER_ID" length="64"/>
            </basic>
            <basic name="applicationId">
                <column name="APPLICATION_ID" length="128"/>
            </basic>
            <basic name="Status">
                <column name="STATUS" nullable="false" length="32"/>
            </basic>
            <basic name="date">
                <column name="EVENT_DATE" nullable="false"/>
                <temporal>TIMESTAMP</temporal>
            </basic>
        </attributes>
    </entity>
</entity-mappings>

